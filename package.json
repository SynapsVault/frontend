{
  "name": "@synapsvault/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "NODE_ENV=production vite build",
    "bundle:stats": "tsc && vite build && open stats.html",
    "bundle:check": "npm run build && node scripts/check-bundle-size.mjs",
    "bundle:analyze": "open stats.html",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "docker:build": "docker build -t synapsvault-frontend:latest .",
    "docker:run": "docker run -p 8080:8080 synapsvault-frontend:latest",
    "check": "npm run lint && npm run typecheck && npm test && npm run bundle:check && node scripts/scan-secrets.mjs && npm run i18n:check",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@sentry/react": "^11.17.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^17.4.0",
    "@x402/fetch": "^2.9.0",
    "@x402/stellar": "^2.29.0",
    "i18next": "^27.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^18.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.4.49",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.4",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
