# SynapsVault Frontend — Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.

# ────────────────────────────────────────────────────────────────────────────
# Required Configuration
# ────────────────────────────────────────────────────────────────────────────

# Backend API URL (SynapsVault/backend)
#
# Development: leave EMPTY. The Vite dev server proxies every API route
#   (/resources, /agent, /registry, /publishers, /buyers, /payments) to
#   VITE_DEV_PROXY_TARGET, so there are no CORS issues. Start the backend with
#   `npm run dev` in SynapsVault/backend.
#
# Production on Vercel: leave empty or use /api. vercel.json forwards /api/*
# to https://backend-1bhj.vercel.app. Update that destination when
# changing backends. This avoids browser CORS failures.
# For other hosts, provide an equivalent proxy or set an HTTPS backend URL
# and allow that origin in both backend CORS and the host's connect-src CSP.
VITE_API_URL=

# Where the dev server proxies API requests (development only).
# VITE_DEV_PROXY_TARGET=http://localhost:3000

# Stellar network: testnet (default) or mainnet.
# Controls payments, wallet signing, explorer links, and the sidebar badge.
VITE_NETWORK=testnet

# ────────────────────────────────────────────────────────────────────────────
# Authentication & Publishing
# ────────────────────────────────────────────────────────────────────────────

# Optional wallet authentication service (separate from the marketplace API).
# Empty disables sign-in. Use a same-origin path such as /auth with a host proxy,
# or permit the external auth origin in connect-src and its CORS configuration.
# Contract: POST /challenge {address} -> {challenge, expiresAt};
# POST /session {address, challenge, signature} -> {token, expiresAt}.
# expiresAt is Unix milliseconds. The service must verify wallet signatures,
# enforce one-use challenges and issue scoped, short-lived session tokens.
# The current marketplace backend does not implement these endpoints.
# Never put publisher keys, signing secrets, or session tokens in VITE_* vars.
VITE_AUTH_PROXY_URL=

# ────────────────────────────────────────────────────────────────────────────
# Optional: Observability & Monitoring
# ────────────────────────────────────────────────────────────────────────────

# Sentry DSN for error tracking
# Get from https://sentry.io after creating a project
VITE_SENTRY_DSN=

# ────────────────────────────────────────────────────────────────────────────
# Feature Flags & Advanced
# ────────────────────────────────────────────────────────────────────────────

# Enable development mode features (debug logging, longer timeouts)
# Comment out or set to false for production
# VITE_DEBUG=true

# Enable verbose logging in console
# VITE_VERBOSE_LOGGING=true
